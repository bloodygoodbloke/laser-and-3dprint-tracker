{
  "name": "fab-work-tracker-frontend",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check:frontend-smoke": "node ../scripts/smoke-frontend-check.js",
    "check:local": "npm run check:frontend-smoke && npm run check:tracker && npm run check:quality-cadence && npm run check:release",
    "check:release": "node ../scripts/check-release-notes.js",
    "check:tracker": "node ../scripts/check-tracker-consistency.js",
    "check:quality-cadence": "node ../scripts/check-quality-cadence.js",
    "preversion": "npm run check:release && npm run check:tracker && npm run check:quality-cadence"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
