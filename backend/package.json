{
  "name": "fab-work-tracker-backend",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma": "prisma",
    "check:api-smoke": "node ../scripts/smoke-api-check.js",
    "check:local": "npm run test:print-time && npm run test:auth && npm run test:upload && npm run test:storage && npm run test:makerworld-browser && npm run check:version && npm run check:api-smoke && npm run check:tracker && npm run check:quality-cadence && npm run check:release",
    "test:print-time": "node --test ../scripts/print-time.test.js",
    "test:auth": "node --import tsx --test ../scripts/auth.test.js",
    "test:upload": "node --import tsx --test ../scripts/upload.test.js",
    "test:storage": "node --import tsx --test ../scripts/storage.test.js",
    "test:makerworld-browser": "node --import tsx --test ../scripts/makerworld-browser.test.js",
    "check:version": "node ../scripts/check-version-info.js",
    "check:release": "node ../scripts/check-release-notes.js",
    "check:tracker": "node ../scripts/check-tracker-consistency.js",
    "check:quality-cadence": "node ../scripts/check-quality-cadence.js",
    "preversion": "npm run check:release && npm run check:tracker && npm run check:quality-cadence"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@azure/storage-blob": "^12.34.0",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jose": "^6.2.14",
    "multer": "^2.5.0",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "prisma@7.10.1": true
  }
}
