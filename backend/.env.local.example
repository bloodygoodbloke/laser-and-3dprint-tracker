# Copy this file to backend/.env.local and fill with your own values.
# backend/.env.local is git-ignored.

# Backend runtime
PORT=4000

# SQLite database (path is relative to backend/prisma). Container uses file:/data/makerflow.db
DATABASE_URL=file:./dev.db

# GitHub issue reporting from the Help page (fine-grained token with Issues: read/write on the repo).
# Never commit a real token.
GITHUB_TOKEN=
GITHUB_REPOSITORY=bloodygoodbloke/laser-and-3dprint-tracker
