# Copy this file to backend/.env.local and fill with your own values.
# backend/.env.local is git-ignored.

# Backend runtime
PORT=4000

# SQLite database (path is relative to backend). Container uses file:/data/makerflow.db
DATABASE_URL=file:./prisma/dev.db

# GitHub issue reporting from the Help page (fine-grained token with Issues: read/write on the repo).
# Never commit a real token.
GITHUB_TOKEN=
GITHUB_REPOSITORY=bloodygoodbloke/laser-and-3dprint-tracker

# Authentication (Microsoft Entra External ID). With none of these set, protected routes return 503 (fail closed).
ENTRA_ISSUER=
ENTRA_JWKS_URI=
ENTRA_CLIENT_ID=
# Super admin(s): comma-separated emails. They manage invites/approvals in Admin > User access and are Owner of the first workspace.
SUPER_ADMIN_EMAILS=
# Optional extra emails that become Owner of the first workspace on first sign-in.
OWNER_EMAILS=
# Comma-separated allowed browser origins; defaults to the local Vite dev server outside production, none in production.
CORS_ORIGIN=
# Local development only (ignored when NODE_ENV=production): skips authentication entirely.
AUTH_DISABLED=true
