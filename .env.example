KWH_RATE=0.20
LABOUR_RATE=20
OVERHEAD_PERCENT=0.15
PRINTER_WATTAGE=120
LASER_WATTAGE=40
PORT=4000

# File storage: "local" (default) or "azure". If unset, Azure is chosen automatically when a connection
# string is set, or when running in Azure Container Apps with AZURE_STORAGE_ACCOUNT set.
STORAGE_PROVIDER=local
UPLOAD_PATH=./uploads
# Azure Blob Storage: use a connection string, or just the account name (managed identity / az login).
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=uploads
